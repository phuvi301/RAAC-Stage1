# ==========================================
# RAAC Stage 1: TV1 Environment Configuration
# ==========================================

# 1. GitHub API Configuration (Task 1.3 Crawler)
# Tạo token tại: https://github.com/settings/tokens (classic token hoặc fine-grained)
# Yêu cầu quyền: public_repo (đọc repo public)
GITHUB_TOKEN=your_github_personal_access_token_here

# 2. LLM Provider API Keys (Task 1.7 - 1.9 Requirement Analyzer)
# Cấu hình một trong các nhà cung cấp bên dưới tùy chọn lựa chọn:

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (Gemini 1.5 Pro, Gemini 1.5 Flash)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 9Router Configuration (Local AI Gateway: http://127.0.0.1:20128)
# Tự động kết nối tới instance 9router (hỗ trợ tự động nhận diện API key từ local SQLite)
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=sk-your-9router-api-key
NINEROUTER_MODEL=ag/gemini-3.8-flash

# Chế độ LLM Mặc định: "9router", "openai", "gemini", "anthropic", hoặc "mock"
LLM_PROVIDER=9router

